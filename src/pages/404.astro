---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import PostCard from '../components/PostCard.astro';
import { getAssetUrl } from '../config';
import { sortProjects } from '../data/portfolio';
const recommended = (await getCollection('posts', ({data}) => !data.draft && !!data.projectCategory)).sort(sortProjects).slice(0,3);
---
<Layout title="404 — Page Not Found" current="error">
  <header class="site-header outer"><div class="inner"><SiteNav /></div></header>
  <main id="site-main" class="site-main outer"><div class="inner">
    <header class="page-intro"><p class="eyebrow">404 / OFF THE MAP</p><h1>This page is uncharted.</h1><p>The page you're looking for isn't here. Explore a project, or head back to the start.</p><a class="pill primary" href={getAssetUrl('/')}>Back to Home ↗</a></header>
    <section class="portfolio-section more-projects" aria-label="Suggested projects"><div class="post-feed standard-feed">{recommended.map(post => <PostCard post={post} />)}</div></section>
  </div></main>
</Layout>
