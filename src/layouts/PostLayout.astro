---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import Layout from './Layout.astro';
import ResponsiveYouTubeEmbed from '../components/ResponsiveYouTubeEmbed.astro';
import { youtubeEmbed } from '../utils/youtube';
import { categories } from '../data/portfolio';
import SiteNav from '../components/SiteNav.astro';
import PostCard from '../components/PostCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectResources from '../components/ProjectResources.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import GlacierArtwork from '../components/GlacierArtwork.astro';
import OceanWaves from '../components/OceanWaves.astro';
import PortfolioIcon from '../components/PortfolioIcon.astro';
import { SITE_CONFIG, getAssetUrl } from '../config';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, cover, tags = [], author, date, description, subclass, disqus } = post.data;

// Resolve author using data collection entry reference
const authorEntry = author ? await getEntry(author) : null;
const authorData = authorEntry ? authorEntry.data : null;
const authorKey = authorEntry ? authorEntry.id : '';

// Get all posts for next/prev/related suggestions
const allPostsUnsorted = await getCollection('posts', ({ data }) => !data.draft);
const allPosts = [...allPostsUnsorted].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const currentIndex = allPosts.findIndex(p => p.id === post.id);
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Related posts
const primaryTag = tags[0];
const relatedPosts = primaryTag
  ? allPosts.filter(p => p.id !== post.id && p.data.tags.includes(primaryTag))
  : [];
const relatedCount = relatedPosts.length;
const relatedCards = [...relatedPosts, nextPost, prevPost]
  .filter((entry): entry is CollectionEntry<'posts'> => !!entry)
  .filter((entry, index, entries) => entries.findIndex(p => p.id === entry.id) === index)
  .slice(0, 3);

// Format date
const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const isDisqusEnabled = disqus !== false && SITE_CONFIG.disqus;
---

<Layout
  title={title}
  description={description}
  image={cover}
  type="article"
  articleDate={post.data.dateVerified ? date : undefined}
  tags={tags}
  author={authorData?.name}
  current="post"
>
    <!-- Post Header -->
    <header class="site-header outer">
        <div class="inner">
            <SiteNav current="post" />
        </div>
    </header>

    <!-- Main Content Area -->
    <main id="site-main" class="site-main outer" role="main">
        <div class="inner">
            <nav class="project-breadcrumb" aria-label="Breadcrumb"><a href={getAssetUrl('/projects/')}>Projects</a><span aria-hidden="true">›</span><span aria-current="page">{title}</span></nav>
            <article class={`post-full ${tags.map(t => `tag-${t.toLowerCase().replace(/\s+/g, '-')}`).join(' ')} ${subclass || ''} ${!cover ? 'no-image' : ''}`}>
                {youtubeEmbed(post.data.youtubeUrl) ? <ResponsiveYouTubeEmbed url={post.data.youtubeUrl!} title={title} label={post.data.youtubeLabel} /> : cover && <figure class="post-full-image"><ProjectImage src={cover} alt={post.data.coverAlt || title} title={title} category={post.data.projectCategory} position={post.data.coverPosition} eager={true} width={1200} height={675} /></figure>}
                <header class="post-full-header project-heading">
                    <GlacierArtwork placement="article" />
                    <div class="project-heading-copy">
                        <h1 class="post-full-title">{title}</h1>
                        {description && <p class="project-summary">{description}</p>}
                        <ul class="tech-tags" aria-label="Technologies">{post.data.technologies.map(tech => <li>{tech}</li>)}</ul>
                        <div class="post-full-meta">
                            {post.data.dateVerified && <span class="project-date"><PortfolioIcon name="calendar" /><time datetime={new Date(date).toISOString().split('T')[0]}>{post.data.dateLabel || formattedDate}</time></span>}
                            {post.data.projectCategory && <a class="project-category-label" href={getAssetUrl(`/tag/${post.data.projectCategory}/`)}><PortfolioIcon name="tag" />{categories.find(c => c.id === post.data.projectCategory)?.title || post.data.projectCategory}</a>}
                            {!post.data.projectCategory && tags.map(tag => <a href={getAssetUrl(`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`)}>{tag}</a>)}
                        </div>
                        {post.data.githubUrl && <a class="pill" href={post.data.githubUrl} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a>}
                    </div>
                </header>

                <section class="post-full-content">
                    <div class="kg-card-markdown">
                        <!-- Render post body -->
                        <slot />
                        <ProjectResources post={post} />
                    </div>
                </section>

                <!-- Email subscribe form at the bottom of the page -->
                {SITE_CONFIG.subscribers && (
                    <section class="subscribe-form">
                        <h3 class="subscribe-form-title">Subscribe to {SITE_CONFIG.title}</h3>
                        <p>Get the latest posts delivered right to your inbox</p>
                        <SubscribeForm placeholder="youremail@example.com" />
                    </section>
                )}

                <footer class="post-full-footer">
                    {authorData && (
                        <section class="author-card">
                            {authorData.picture && (
                                <img class="author-profile-image" src={getAssetUrl(authorData.picture)} alt={authorData.name} loading="lazy" />
                            )}
                            <section class="author-card-content">
                                <h4 class="author-card-name"><a href={getAssetUrl(`/author/${authorKey}/`)}>{authorData.name}</a></h4>
                                {authorData.bio ? (
                                    <p>{authorData.bio}</p>
                                ) : (
                                    <p>Read <a href={getAssetUrl(`/author/${authorKey}/`)}>more posts</a> by this author.</p>
                                )}
                            </section>
                        </section>
                        <div class="post-full-footer-right">
                            <a class="author-card-button" href={getAssetUrl(`/author/${authorKey}/`)}>More Projects</a>
                        </div>
                    )}
                </footer>

                <!-- Disqus comments -->
                {isDisqusEnabled && (
                    <section class="post-full-comments">
                        <div id="disqus_thread"></div>
                        <script is:inline define:vars={{
                          shortname: SITE_CONFIG.disqusShortname,
                          url: Astro.url.href,
                          id: post.id,
                          title: title
                        }}>
                            var disqus_config = function () {
                                this.page.url = url;
                                this.page.identifier = id;
                                this.page.title = title;
                            };
                            var loadDisqus = function() {
                                if (window.DISQUS) {
                                    window.DISQUS.reset({
                                        reload: true,
                                        config: disqus_config
                                    });
                                } else {
                                    var d = document, s = d.createElement('script');
                                    s.src = 'https://' + shortname + '.disqus.com/embed.js';
                                    s.setAttribute('data-timestamp', +new Date());
                                    (d.head || d.body).appendChild(s);
                                }
                            };
                            if ('IntersectionObserver' in window) {
                                var observer = new IntersectionObserver(function(entries, observer) {
                                    entries.forEach(function(entry) {
                                        if (entry.isIntersecting) {
                                            loadDisqus();
                                            observer.unobserve(entry.target);
                                        }
                                    });
                                }, { rootMargin: '0px 0px 300px 0px' });
                                var target = document.getElementById('disqus_thread');
                                if (target) {
                                    observer.observe(target);
                                }
                            } else {
                                loadDisqus();
                            }
                        </script>
                    </section>
                )}
            </article>
        </div>
    </main>

    <aside class="read-next outer" aria-label="Related projects">
        <OceanWaves />
        <div class="inner">
            <div class="section-heading"><div><p class="eyebrow">CONTINUE EXPLORING</p><h2>Related Projects</h2></div>{relatedCount > 0 && primaryTag && <a class="text-link" href={getAssetUrl(`/tag/${primaryTag.toLowerCase().replace(/\s+/g, '-')}/`)}>Explore {primaryTag} projects <span aria-hidden="true">→</span></a>}</div>
            <div class="post-feed standard-feed">{relatedCards.map(post => <PostCard post={post} />)}</div>
            <nav class="project-pagination" aria-label="Previous and next projects">
                {prevPost && <a href={getAssetUrl(`/${prevPost.id}/`)} rel="prev"><span>← Previous project</span>{prevPost.data.title}</a>}
                {nextPost && <a href={getAssetUrl(`/${nextPost.id}/`)} rel="next"><span>Next project →</span>{nextPost.data.title}</a>}
            </nav>
        </div>
    </aside>
</Layout>
