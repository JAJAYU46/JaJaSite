---
import { getAssetUrl } from '../config';
interface Props { placement: 'hero' | 'article'; }
const { placement } = Astro.props;
---
<div class={`glacier-art glacier-art-${placement}`} aria-hidden="true">
  <img src={getAssetUrl('/assets/images/glacier-landscape.svg')} alt="" aria-hidden="true" width="760" height="400" decoding="async" />
</div>
