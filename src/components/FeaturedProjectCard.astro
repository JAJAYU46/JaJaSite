---
import type { CollectionEntry } from 'astro:content';
import { getAssetUrl } from '../config';
import ProjectVisual from './ProjectVisual.astro';
import ProjectImage from './ProjectImage.astro';
interface Props { post: CollectionEntry<'posts'>; index: number; }
const {post, index} = Astro.props;
---
<article class:list={['featured-project', { 'is-reversed': index % 2 === 1 }]}>
  <a class="featured-project-link" href={getAssetUrl(`/${post.id}/`)}>
    <div class="featured-copy">
      <div class="featured-kicker"><span>{String(index + 1).padStart(2, '0')}</span> ROBOTICS & AUTONOMOUS SYSTEMS</div>
      <h3>{post.data.title}</h3><p>{post.data.description}</p>
      <ul class="tech-tags" aria-label="Technologies">{post.data.technologies.map(tech => <li>{tech}</li>)}</ul>
      <span class="explore-link">Explore Project <span class="project-arrow" aria-hidden="true">→</span></span>
    </div>
    <div class="featured-media" style={{ '--cover-position': post.data.coverPosition }}>{post.data.cover ? <ProjectImage src={post.data.cover} alt={post.data.coverAlt || post.data.title} title={post.data.title} category={post.data.projectCategory} position={post.data.coverPosition} variant={post.data.featuredOrder ? post.data.featuredOrder - 1 : undefined} /> : <ProjectVisual title={post.data.title} category={post.data.projectCategory} variant={post.data.featuredOrder ? post.data.featuredOrder - 1 : undefined} />}</div>
  </a>
</article>
