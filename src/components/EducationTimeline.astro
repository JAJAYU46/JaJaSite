---
import { timeline } from '../data/portfolio';
---
<section class="journey" aria-labelledby="journey-title">
  <div class="section-caption"><span class="eyebrow" id="journey-title">THE JOURNEY SO FAR</span><span>Learning. Building. Exploring.</span></div>
  <ol class="education-timeline">
    {timeline.map(item => <li><span class="timeline-node" aria-hidden="true">{item.icon}</span><p class="timeline-date">{item.date}</p><h3>{item.title}</h3><p>{item.detail}</p></li>)}
  </ol>
</section>
