---
import Navigation from './Navigation.astro';
import Github from './icons/Github.astro';
import LinkedIn from './icons/LinkedIn.astro';
import { getAssetUrl } from '../config';
import { portfolio } from '../data/portfolio';
interface Props { current?: string; }
---
<nav class="site-nav" aria-label="Main navigation">
  <a class="jaja-brand" href={getAssetUrl('/')} aria-label="JaJa. Home">JaJa<span>.</span></a>
  <Navigation current={Astro.props.current} />
  <div class="nav-socials">
    <a href={portfolio.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Github /></a>
    {portfolio.linkedin ? <a href={portfolio.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><LinkedIn /></a> : <span class="unavailable" aria-label="LinkedIn coming soon" aria-disabled="true"><LinkedIn /></span>}
  </div>
</nav>
